<?xml version="1.0" encoding="utf-8"?>
<!-- opaque box (white, or black in the dark theme) with rounded corners, used to group values on the station summary -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/summary_box_background" />
    <corners android:radius="12dp" />
    <padding
        android:left="12dp"
        android:top="8dp"
        android:right="12dp"
        android:bottom="8dp" />
</shape>
